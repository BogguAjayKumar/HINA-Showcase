# ==============================================================================
# HINA Multi-API Configuration & Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-LLM Cloud Providers & Key Pools (Supports single or comma-separated keys)
# ------------------------------------------------------------------------------
# Google Gemini (Supports key pooling: key1,key2,key3)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3

# Groq (Ultra-low latency for voice responses - free tier available at console.groq.com)
GROQ_API_KEY=
# GROQ_API_KEYS=key1,key2

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=
# OPENAI_API_KEYS=key1,key2

# Anthropic Claude (Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEYS=key1,key2

# DeepSeek (DeepSeek-V3 / DeepSeek-R1)
DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEYS=key1,key2

# OpenRouter (Unified router for hundreds of open & closed models)
OPENROUTER_API_KEY=

# Ollama (Local private offline LLM - no key required)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 2. External Service Tool APIs (Optional: Built-in free fallbacks require zero keys)
# ------------------------------------------------------------------------------
# OpenWeatherMap API (Optional: HINA uses live Open-Meteo & wttr.in automatically if omitted)
OPENWEATHER_API_KEY=

# NewsAPI Key (Optional: HINA uses live Google News RSS automatically if omitted)
NEWS_API_KEY=

# ------------------------------------------------------------------------------
# 3. Optional Email Configuration (IMAP / SMTP)
# ------------------------------------------------------------------------------
EMAIL_USER=
EMAIL_PASSWORD=
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ------------------------------------------------------------------------------
# 4. Smart Home & IoT
# ------------------------------------------------------------------------------
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
