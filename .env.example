# ==========================================
# HINA Environment Secrets
# ==========================================

# 1. Google Gemini API Key (100% Free at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI API Key (Optional fallback)
OPENAI_API_KEY=

# 3. Optional Email Configuration (IMAP / SMTP)
EMAIL_USER=
EMAIL_PASSWORD=
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# 4. Optional Smart Home / Home Assistant / MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
